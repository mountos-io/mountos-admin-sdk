{
  "name": "@mountos-io/admin-sdk",
  "version": "1.30.0",
  "description": "TypeScript SDK for mountOS, a cross-platform, forkable, time-traveling distributed filesystem over object storage. Automate accounts, users, volumes, forks, quotas, and audit logs.",
  "keywords": [
    "mountos",
    "posix-filesystem",
    "object-storage",
    "s3",
    "volumes",
    "storage-provisioning",
    "admin-sdk",
    "ai-agents"
  ],
  "homepage": "https://mountos.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mountos-io/mountos-admin-sdk.git",
    "directory": "ts"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "api.yaml",
    "api.md",
    "SKILL.md"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "tsc && node --test \"test/**/*.test.ts\"",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "jose": "^6.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.12.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.0"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}
